# CLI tools for the dev environment. install.sh runs `brew bundle` with this.
brew "git"
brew "neovim"       # LazyVim needs >= 0.11
brew "tmux"
brew "ripgrep"      # LazyVim live grep
brew "fd"           # LazyVim file finder
brew "fzf"
brew "lazygit"
brew "node"         # some LSP servers installed by Mason need it
brew "tree-sitter-cli"
brew "mosh"         # low-latency, roaming-friendly SSH alternative
